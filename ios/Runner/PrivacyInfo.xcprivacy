<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 앱 자체 코드는 추적 도메인에 직접 접속하지 않음 → 앱 레벨은 false.
	     추적(AdMob·Facebook) 선언은 각 SDK의 자체 매니페스트가 담당 (FBSDKCoreKit 등).
	     주의: true로 두려면 NSPrivacyTrackingDomains 목록이 필수(ITMS-91064)인데,
	     광고 도메인을 여기 나열하면 ATT 거부 시 iOS가 차단해 비동의 광고까지 죽음. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- shared_preferences → NSUserDefaults (앱 내부 데이터 저장/조회 전용) -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- path_provider → 앱 컨테이너 내 파일 타임스탬프 접근 -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- 파일 쓰기 전 여유 공간 확인 등 디스크 용량 조회 -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
